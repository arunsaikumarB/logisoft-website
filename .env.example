# Copy to .env and replace the placeholders. Do not commit .env.

# Pooled Postgres URL used by the Neon client (server/db.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Direct (unpooled) Postgres URL used by Drizzle migrations (drizzle.config.ts, scripts/maybe-migrate.mjs).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Port for `pnpm start` (server/node-build.ts). Defaults to 3000.
PORT=3000

# Optional text returned by GET /api/ping (server/index.ts). Defaults to "ping".
PING_MESSAGE=ping

# Set to feature to run database migrations on dev startup. Leave empty otherwise.
FUSION_BRANCH_KIND=

# Runtime mode. Vite, Netlify, and `pnpm start` set this themselves.
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# When unset, the API allows https://logisoftit.com and https://www.logisoftit.com.
# Outside production, http://localhost:8080 and http://localhost:3000 are added too.
# Add the Netlify hostname here when the site is served from one.
CORS_ORIGINS=https://logisoftit.com,https://www.logisoftit.com
